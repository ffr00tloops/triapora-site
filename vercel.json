{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.triaporasecurity.com"
        }
      ],
      "destination": "https://triaporasecurity.com/",
      "permanent": true
    }
  ]
}
